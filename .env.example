APP_NAME=FastAPI Task
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
WORKERS=1

# 任务列表缓存 TTL（秒）
TASK_LIST_CACHE_TTL=30

# SMTP 邮件通知（任务失败时发送，不配置则跳过）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_USER=your@example.com
SMTP_PASSWORD=your_password
SMTP_TO=admin@example.com

# SMB / 网络共享盘配置
# Windows 服务运行在 Session 0，看不到用户桌面映射的盘符。
# 服务启动时自动挂载（先断开再重连），不影响用户桌面会话的同名盘符。
SMB_DRIVE_LETTER=F:
SMB_SHARE_PATH=\\192.168.1.100\data
SMB_USERNAME=userl
SMB_PASSWORD=

