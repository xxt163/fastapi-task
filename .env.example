APP_NAME=FastAPI Task
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
WORKERS=1

# 任务列表缓存 TTL（秒）
TASK_LIST_CACHE_TTL=30

# SMTP 邮件通知（任务失败时发送，不配置则跳过）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_USER=your@example.com
SMTP_PASSWORD=your_password
SMTP_TO=admin@example.com

